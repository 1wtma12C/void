{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "checkJs": false,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*", "src/**/*.jsx", "src/**/*.js"]
}
